PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/buildtogether?retryWrites=true&w=majority
MONGO_DB_NAME=buildtogether
CLIENT_URLS=https://<your-project>.pages.dev
SESSION_MAX_AGE_SECONDS=43200

# Set either this JSON value, or the three Firebase variables below. Do not commit credentials.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"<project-id>","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@<project-id>.iam.gserviceaccount.com"}
# FIREBASE_PROJECT_ID=<project-id>
# FIREBASE_CLIENT_EMAIL=<service-account-email>
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n
